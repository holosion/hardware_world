# Existing MySQL server (also accessible through MySQL Workbench).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password

# Separate simplified schema on the same server.
SIMPLE_DB_NAME=hardware_world_simple

# Optional existing URL supplies credentials instead of DB_* settings.
# Its database name is ignored; SIMPLE_DB_NAME selects the new schema.
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/hardware_world

ADMIN_NAME=Store Administrator
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@hardwareworld.local
ADMIN_PASSWORD=replace-with-your-own-password
SECRET_KEY=replace-with-a-long-random-string
APP_PORT=8000
CURRENCY=UGX
COOKIE_SECURE=false

# Optional folder for CSV snapshots. Default: backend/backups
# CSV_BACKUP_DIR=C:/HardwareWorldBackups
