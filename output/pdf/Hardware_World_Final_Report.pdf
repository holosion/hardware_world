0 0 0 rg
BT 1 0 0 1 0 375 Tm /F3 9 Tf 12 TL (-- 4. Low stock) Tj T* (SELECT name,stock,reorder_level FROM products) Tj T* (WHERE stock<=reorder_level;) Tj T* (-- 5. Products with categories) Tj T* (SELECT p.name,c.name AS category FROM products p) Tj T* (JOIN categories c ON c.id=p.category_id;) Tj T* (-- 6. Sale totals) Tj T* (SELECT s.id,SUM\(i.quantity*i.unit_price\) AS total) Tj T* (FROM sales s JOIN sale_items i ON i.sale_id=s.id) Tj T* (GROUP BY s.id;) Tj T* (-- 7. Employee totals) Tj T* (SELECT e.name,SUM\(i.quantity*i.unit_price\) AS total) Tj T* (FROM employees e JOIN sales s ON s.employee_id=e.id) Tj T* (JOIN sale_items i ON i.sale_id=s.id) Tj T* (GROUP BY e.id,e.name;) Tj T* (-- 8. Unsold products) Tj T* (SELECT p.name FROM products p) Tj T* (LEFT JOIN sale_items i ON i.product_id=p.id) Tj T* (WHERE i.id IS NULL;) Tj T* (-- 9. Supplier catalogue) Tj T* (SELECT s.name,p.name,x.cost_price,x.lead_time_days) Tj T* (FROM supply x JOIN suppliers s ON s.id=x.supplier_id) Tj T* (JOIN products p ON p.id=x.product_id;) Tj T* (-- 10. Recursive relationship) Tj T* (SELECT e.name,m.name AS supervisor FROM employees e) Tj T* (LEFT JOIN employees m ON m.id=e.supervisor_id;) Tj T* (-- 11. Payroll) Tj T* (SELECT e.name,p.pay_month,p.gross_pay,p.deductions,p.net_pay) Tj T* (FROM payroll p JOIN employees e ON e.id=p.employee_id;) Tj T* (-- 12. Ledger) Tj T* (SELECT source_type,SUM\(amount\) AS total) Tj T* (FROM ledger_entries GROUP BY source_type;) Tj T* ET
Q
